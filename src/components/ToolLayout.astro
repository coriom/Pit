---
import type { ToolDefinition } from "../lib/tool-registry";
import "../styles/global.css";
const { tool } = Astro.props as { tool: ToolDefinition };
const modeLabel = {
  local: "Local · no wallet or network",
  "read-only": "Read-only · no transaction",
  execution: "Execution · wallet approval required",
}[tool.executionMode];
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={tool.description} />
    <title>{tool.title} · PIT Toolbox</title>
  </head>
  <body>
    <main class="shell">
      <header>
        <a href="../../" class="brand">pit<span>.</span></a>
        <nav><a href="../">Toolbox</a><a href="../../">Trade</a><a href="../../fees/">Fees</a><a href="../../legal/">Legal</a></nav>
        <span class="tag">TESTNET PREVIEW</span>
      </header>
      <section class="hero">
        <div class="eyebrow">{tool.category} / {tool.status}</div>
        <h1>{tool.title}</h1>
        <p>{tool.description}</p>
        <p class="tool-mode">{modeLabel}</p>
      </section>
      <slot />
      <footer><a href="../">← All tools</a> · Non-custodial · No address analytics</footer>
    </main>
  </body>
</html>
