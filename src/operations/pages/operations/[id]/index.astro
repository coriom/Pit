---
import Layout from "../../../components/Layout.astro";
import { operationCatalog } from "../../../lib/catalog";
export function getStaticPaths(){return operationCatalog.map((item)=>({params:{id:item.id},props:{item}}));}
const { item } = Astro.props;
---
<Layout title={item.title} description={item.description}><section class="hero"><div class="eyebrow">{item.category} · local Anvil only</div><h1>{item.title}</h1><p>{item.description}</p><p class="notice">Indicative PIT service fee: {item.fee}, inactive. Estimated gas is shown separately after local simulation. No total remote cost is quoted.</p></section><div class="panel"><ol class="steps" aria-label="Workflow"><li>Configure</li><li>Validate</li><li>Review</li><li>Simulate</li><li>Execute locally</li><li>Inspect result</li></ol><p class="muted">Use only disposable Anvil test accounts. The connected wallet signs a local transaction; PIT receives no tokens or administrative roles.</p></div><div id="operation-root" data-operation={item.id}></div><script src="../../../browser.ts"></script></Layout>
