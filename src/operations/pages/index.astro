---
import Layout from "../components/Layout.astro";
import { operationCatalog } from "../lib/catalog";
---
<Layout title="PIT operations" description="Local token, NFT and distribution operations for Anvil."><section class="hero"><div class="eyebrow">PIT V2 · local operations</div><h1>Prepare, simulate and inspect Web3 operations.</h1><p>Token, NFT, distribution and schedule workflows execute only against local Anvil chain 31337. Read-only tools do not require a wallet.</p><p class="notice">Commercial fees are indicative proposals and inactive. Local gas measurements are not remote quotes.</p><label>Search operations<input id="operation-search" type="search" autocomplete="off" placeholder="Token, NFT, allowance…" /></label><p id="search-count" role="status" aria-live="polite">{operationCatalog.length} local operations</p></section>{[...new Set(operationCatalog.map((item)=>item.category))].map((category)=><section data-category><h2>{category} · {operationCatalog.filter((item)=>item.category===category).length}</h2><div class="grid">{operationCatalog.filter((item)=>item.category===category).map((item)=><a class="panel" data-tool data-search={`${item.title} ${item.description} ${item.category}`.toLowerCase()} href={`/operations/${item.id}/`}><small class="eyebrow">{item.category}</small><h3>{item.title}</h3><p>{item.description}</p><small>PIT fee: {item.fee}</small></a>)}</div></section>)}<script src="../bootstrap.ts"></script></Layout>
