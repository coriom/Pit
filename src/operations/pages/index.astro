---
import Layout from "../components/Layout.astro";
import ProductDirectory from "../components/ProductDirectory.astro";
import { V2_CATEGORIES } from "../../lib/v2-catalog-core";
const hosted = process.env.PIT_HOSTED_STAGING === "1";
const unified = process.env.PIT_UNIFIED_PREVIEW === "1";
---
<Layout title="PIT Web3 tools" description="Free local analysis, read-only blockchain inspections and separately isolated local operations.">
  <section class="hero product-hero">
    <p class="hero-kicker">Financial tools · On-chain insight · Token workflows</p>
    <h1>Web3 work, made clearer.</h1>
    <p class="hero-copy">Analyze risk, inspect public chains and prepare token operations in one place.</p>
    <label class="hero-search" for="operation-search"><span>Search tools</span><input id="operation-search" type="search" autocomplete="off" placeholder="Search tools, tasks or categories" aria-controls="product-catalogue" /></label>
    <div class="hero-meta"><a href="#directory">Browse all tools</a><span aria-hidden="true">·</span><a href="/guide/">How PIT works</a></div>
  </section>
  <section class="category-section" aria-labelledby="category-title"><div class="section-heading"><h2 id="category-title">Explore by category</h2><span>Nine ways to get started</span></div><div class="category-rail">{V2_CATEGORIES.map((category) => <a href={`/?category=${encodeURIComponent(category.id)}#directory`}>{category.label}</a>)}</div></section>
  <section aria-label="Product areas" class="product-lanes">
    {unified && <><a href="/toolbox/"><span>01 / FREE</span><strong>Toolbox</strong><small>Calculators and local data tools</small></a><a href="/explorer/"><span>02 / FREE</span><strong>Explorer</strong><small>Read public blockchain data</small></a></>}
    <a href="#directory"><span>{unified ? "03" : "01"} / PREVIEW</span><strong>Operations</strong><small>Token creation, distribution and management</small></a>
  </section>
  <ProductDirectory />
  <aside class="home-note"><div><h2>Clear costs, considered actions.</h2><p>Free tools stay free. Operation prices are indicative; network gas and token approvals are separate. {hosted ? "This private preview cannot sign or send transactions." : "Local execution is limited to Anvil."}</p></div><a href="/guide/">Read the guide</a></aside>
  <script src="../bootstrap.ts"></script>
</Layout>
