---
import { operationCatalog } from "../lib/catalog";
import { V2_LOCAL_TASKS } from "../../lib/v2-local-catalog";
import { V2_EXPLORER_TASKS } from "../../lib/v2-explorer-catalog";
import { V2_CATEGORIES } from "../../lib/v2-catalog-core";

// Static presentation over authoritative registries. The three build trees
// retain separate entry points, JavaScript and network policies.
const unified = process.env.PIT_UNIFIED_PREVIEW === "1";
const categories = V2_CATEGORIES.map(({ id, label }) => ({ id, label }));
const cards = [
  ...(unified ? V2_LOCAL_TASKS.map((item) => ({
    id: `toolbox-${item.id}`, title: item.title, description: item.description,
    category: item.category, path: item.path!, surface: "Offline Toolbox",
    networks: "offline", usage: "local", price: "Free", fullPrice: "Free", availability: "Available", wallet: "Not required",
  })) : []),
  ...(unified ? V2_EXPLORER_TASKS.map((item) => ({
    id: `explorer-${item.id}`, title: item.title, description: item.description,
    category: item.category, path: item.path!, surface: "Read-only Explorer",
    networks: item.networks.join(" "), usage: "read-only", price: "Free", fullPrice: "Free", availability: "Available for read-only queries", wallet: "Not required",
  })) : []),
  ...operationCatalog.map((item) => ({
    id: `operation-${item.id}`, title: item.title, description: item.description,
    category: categories.find(({ label }) => label === item.category)?.id ?? "developer-tools",
    path: `/operations/${item.id}/`, surface: "Operations", networks: "anvil",
    usage: "transaction", price: item.pricing === "FREE" ? "Free" : `From ${item.fee.match(/[\d.]+(?:[–-][\d.]+)? USDC/)?.[0] ?? "indicative fee"}`,
    fullPrice: item.fee, availability: "Private preview; execution on local Anvil only", wallet: item.id === "metadata-studio" || item.id === "airdrop-composer" || item.id === "batch-balance-checker" ? "Not needed for preparation or reads" : "Required for local execution",
  })),
].sort((a, b) => (a.usage === "transaction" ? 0 : a.usage === "local" ? 1 : 2)
  - (b.usage === "transaction" ? 0 : b.usage === "local" ? 1 : 2));
---
<section id="directory" aria-labelledby="directory-title">
  <div class="section-heading"><div><p class="eyebrow">Directory</p><h2 id="directory-title">All tools</h2></div><p>{unified ? "Calculators, inspections and operations." : "Explore local operations."}</p></div>
  <div class="catalogue-controls">
    <label class="directory-search">Search<input id="directory-search" type="search" autocomplete="off" placeholder="Find a tool" aria-controls="product-catalogue" /></label>
    <label>Category<select id="operation-category"><option value="all">All categories</option>{categories.map(({ id, label }) => <option value={id}>{label}</option>)}</select></label>
    <label>Use<select id="operation-usage"><option value="all">All uses</option><option value="local">Offline calculation</option><option value="read-only">Read-only inspection</option><option value="transaction">Local operation</option></select></label>
    <label>Network<select id="operation-network"><option value="all">All networks</option><option value="offline">Offline</option><option value="ethereum">Ethereum</option><option value="base">Base</option><option value="base-sepolia">Base Sepolia</option><option value="anvil">Anvil only</option></select></label>
    <label>Price<select id="operation-price"><option value="all">All prices</option><option value="free">Free</option><option value="indicative">Indicative fee, inactive</option></select></label>
  </div>
  <div class="directory-status"><p id="search-count" role="status" aria-live="polite">{cards.length} results</p><button id="reset-filters" type="button" class="text-button" hidden>Clear filters</button></div>
  <div class="product-grid" id="product-catalogue">{cards.map((item) => <article class="product-card" data-tool data-search={`${item.title} ${item.description} ${item.category} ${item.id}`.toLowerCase()} data-category={item.category} data-usage={item.usage} data-networks={item.networks} data-price={item.price === "Free" ? "free" : "indicative"}>
    <div class="product-card-body"><p class="product-card-surface">{item.surface}</p><h3><a href={item.path}>{item.title}</a></h3><p class="product-card-description">{item.description}</p></div>
    <div class="product-card-foot"><span>{item.price}{item.usage === "transaction" && " · Preview"}</span><a href={item.path} aria-label={`Open ${item.title}`}>Open</a></div>
    <details class="product-card-details"><summary>Details</summary><p>{item.description}</p><dl><div><dt>Availability</dt><dd>{item.availability}</dd></div><div><dt>Network</dt><dd>{item.networks === "offline" ? "Offline" : item.networks === "anvil" ? "Anvil for local execution" : item.networks.split(" ").join(", ")}</dd></div><div><dt>Wallet</dt><dd>{item.wallet}</dd></div><div><dt>Price</dt><dd>{item.fullPrice}</dd></div></dl></details>
  </article>)}</div>
  <button id="show-all-tools" type="button" class="show-more">Show all tools</button>
  <p id="empty-results" class="empty-results" hidden>No tools match. Try another search or clear the filters.</p>
</section>
