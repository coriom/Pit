---
import "../operations.css";
const { title, description } = Astro.props as { title: string; description: string };
const hosted = process.env.PIT_HOSTED_STAGING === "1";
const unified = process.env.PIT_UNIFIED_PREVIEW === "1";
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><meta http-equiv="Content-Security-Policy" content={`default-src 'none'; script-src 'self'; style-src 'self'; connect-src ${hosted ? "'none'" : "http://127.0.0.1:8545 https:"}; img-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'`}/><meta name="description" content={description}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{title} · {hosted ? "PIT private preview" : "PIT local operations"}</title></head><body><a class="skip" href="#main">Skip to main content</a><div class="shell"><header><a class="brand" href="/">pit<span>.</span></a><nav aria-label="Main navigation"><a href="/">Home</a><a href="/#directory">All tools</a>{unified && <><a href="/toolbox/">Toolbox</a><a href="/explorer/">Explorer</a></>}<a href="/guide/">Guide</a><a href="/operations/token-creator/">Create</a><a href="/operations/multisender/">Distribute</a><a href="/operations/token-locker/">Lock</a><a href="/operations/metadata-studio/">Metadata</a></nav><span class="tag">{hosted ? "PRIVATE READ-ONLY PREVIEW" : "LOCAL ANVIL ONLY"}</span></header><main id="main"><slot/></main><footer>{hosted ? "Private preview · No transactions or PIT fees" : "Private local MVP · No real PIT service fee · No remote-chain transactions"}</footer></div></body></html>
