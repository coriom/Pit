---
import "../operations.css";
import ProductNav from "./ProductNav.astro";
const { title, description } = Astro.props as { title: string; description: string };
const hosted = process.env.PIT_HOSTED_STAGING === "1";
const backendOrigin = process.env.PIT_BACKEND_ENABLED === "1" && !hosted ? process.env.PIT_BACKEND_API_ORIGIN : "";
const pageTitle = title === "PIT Crypto" ? "PIT Crypto · Web3 tools" : `${title} · PIT Crypto ${hosted ? "preview" : "local operations"}`;
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><meta http-equiv="Content-Security-Policy" content={`default-src 'none'; script-src 'self'; style-src 'self'; connect-src ${hosted ? "'none'" : `http://127.0.0.1:8545 https: ${backendOrigin}`}; img-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'`}/><meta name="description" content={description}/><meta property="og:type" content="website"/><meta property="og:site_name" content="PIT Crypto"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{pageTitle}</title></head><body><a class="skip" href="#main">Skip to main content</a><ProductNav/><div class="shell"><main id="main"><slot/></main><footer><span>PIT Crypto</span><span>{hosted ? "Read-only preview · Transactions unavailable" : "Local development · Anvil only"}</span><a href="/guide/">Usage &amp; security</a></footer></div><script is:inline src="/nav.js" defer></script></body></html>
