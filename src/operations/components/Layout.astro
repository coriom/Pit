---
import "../operations.css";
import ProductNav from "./ProductNav.astro";
const { title, description } = Astro.props as { title: string; description: string };
const hosted = process.env.PIT_HOSTED_STAGING === "1";
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><meta http-equiv="Content-Security-Policy" content={`default-src 'none'; script-src 'self'; style-src 'self'; connect-src ${hosted ? "'none'" : "http://127.0.0.1:8545 https:"}; img-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'`}/><meta name="description" content={description}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{title} · {hosted ? "PIT private preview" : "PIT local operations"}</title></head><body><a class="skip" href="#main">Skip to main content</a><ProductNav/><div class="shell"><main id="main"><slot/></main><footer><span>PIT</span><span>{hosted ? "Private preview · Read-only" : "Local development · Anvil only"}</span><a href="/guide/">Usage &amp; security</a></footer></div><script is:inline src="/nav.js" defer></script></body></html>
