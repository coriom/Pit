---
const unified = process.env.PIT_UNIFIED_PREVIEW === "1";
const { catalogueHref = "/" } = Astro.props as { catalogueHref?: string };
---
<header class="explorer-site-header">
  <a class="brand" href={unified ? "/" : catalogueHref} aria-label="PIT home">PIT</a>
  <nav class="explorer-desktop-nav" aria-label="Main navigation"><a href={catalogueHref}>All inspections</a>{unified && <><a href="/toolbox/">Toolbox</a><a href="/#directory">All tools</a><a href="/guide/">Guide</a></>}</nav>
  <a class="explorer-nav-search" href={`${catalogueHref}#explorer-search`}>Search</a>
  <details class="explorer-mobile-nav"><summary aria-label="Open navigation menu">Menu</summary><nav aria-label="Mobile navigation"><a href={catalogueHref}>All inspections</a><a href={`${catalogueHref}#explorer-search`}>Search</a>{unified && <><a href="/toolbox/">Toolbox</a><a href="/#directory">All tools</a><a href="/guide/">Guide</a></>}</nav></details>
</header>
