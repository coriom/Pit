---
import { V2_CATEGORIES } from "../../lib/v2-catalog-core";
import { unifiedProductPaths, unifiedCategoryHref } from "../../lib/product-navigation";
const unified = process.env.PIT_UNIFIED_PREVIEW === "1";
const { catalogueHref = "/" } = Astro.props as { catalogueHref?: string };
const path = Astro.url.pathname;
const homeHref = unified ? unifiedProductPaths.home : catalogueHref;
const searchHref = unified ? unifiedProductPaths.search : `${catalogueHref}#explorer-search`;
---
<header class="explorer-site-header">
  <a class="brand" href={homeHref} aria-label={unified ? "PIT home" : "PIT Explorer home"}>PIT</a>
  <nav class="explorer-desktop-nav" aria-label="Main navigation">
    {unified ? <>
      <a href={unifiedProductPaths.home}>Home</a>
      <details class="explorer-tools-menu"><summary>Tools</summary><div class="explorer-tools-panel"><a class="explorer-menu-all" href={unifiedProductPaths.directory}>All tools</a>{V2_CATEGORIES.map((category) => <a data-category={category.id} href={unifiedCategoryHref(category.id)}>{category.label}</a>)}</div></details>
      <a href={unifiedProductPaths.toolbox}>Toolbox</a><a href={unifiedProductPaths.explorer} aria-current={path.startsWith("/explorer/") || path.startsWith("/inspect/") ? "page" : undefined}>Explorer</a><a href={unifiedProductPaths.operations}>Operations</a><a href={unifiedProductPaths.guide}>Guide</a>
    </> : <a href={catalogueHref}>All inspections</a>}
  </nav>
  <a class="explorer-nav-search" href={searchHref}>Search</a>
  <details class="explorer-mobile-nav"><summary aria-label="Open navigation menu">Menu</summary><nav aria-label="Mobile navigation">
    {unified ? <><a href={unifiedProductPaths.home}>Home</a><a href={unifiedProductPaths.directory}>All tools</a><a href={unifiedProductPaths.toolbox}>Toolbox</a><a href={unifiedProductPaths.explorer}>Explorer</a><a href={unifiedProductPaths.operations}>Operations</a><a href={unifiedProductPaths.guide}>Guide</a><details class="explorer-mobile-categories"><summary>Categories</summary><div>{V2_CATEGORIES.map((category) => <a data-category={category.id} href={unifiedCategoryHref(category.id)}>{category.label}</a>)}</div></details></> : <a href={catalogueHref}>All inspections</a>}
    <a href={searchHref}>Search tools</a>
  </nav></details>
</header>
