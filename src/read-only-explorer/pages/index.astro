---
import { EXPLORER_CATEGORIES, EXPLORER_TOOLS } from "../../lib/explorer-registry";
import "../explorer.css";
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><meta name="description" content="Private candidate for manually initiated read-only public-chain inspection." /><title>PIT Explorer · Read-only candidate</title></head><body><a class="skip" href="#main">Skip to main content</a><main id="main" class="shell"><header><a class="brand" href="/">pit<span>.</span> explorer</a><nav aria-label="Main navigation"><a href="/">Explorer</a></nav><span class="tag">READ-ONLY CANDIDATE</span></header><section class="hero"><h1>Inspect public-chain data when you choose.</h1><p>Enter an address, token, name or transaction hash and start a bounded read on Ethereum or Base. No wallet connection, signature or transaction is available.</p><p class="muted">Public RPC providers receive the inputs you submit. Results are snapshots at displayed blocks, not complete security assessments.</p></section><section class="catalogue-controls" aria-label="Find an inspection"><label class="field">Search inspections<input id="explorer-search" type="search" autocomplete="off" placeholder="Search title or purpose" /></label><label class="field">Category<select id="explorer-category"><option value="all">All categories</option>{EXPLORER_CATEGORIES.map((category) => <option value={category}>{category}</option>)}</select></label><p id="explorer-count" role="status" aria-live="polite">{EXPLORER_TOOLS.length} inspections shown</p></section><div class="grid" id="explorer-catalogue">{EXPLORER_TOOLS.map((tool) => <a class="card" href={`/inspect/${tool.id}/`} data-category={tool.category} data-search={`${tool.title} ${tool.question} ${tool.id}`.toLowerCase()}><small>{tool.category} · {tool.chains.map((chain) => chain === "ethereum" ? "Ethereum" : "Base").join(" / ")}</small><h2>{tool.title}</h2><p>{tool.question}</p><small>Manual read · public RPC · no wallet</small></a>)}</div><footer>Private candidate · No indexing · No financial advice</footer></main><script src="../explorer-browser.ts"></script></body></html>
