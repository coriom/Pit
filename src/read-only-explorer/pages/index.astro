---
import { EXPLORER_CATEGORIES, EXPLORER_TOOLS } from "../../lib/explorer-registry";
import { V2_EXPLORER_TASKS } from "../../lib/v2-explorer-catalog";
import "../explorer.css";
import ExplorerNav from "../components/ExplorerNav.astro";
const catalogueHref = process.env.PIT_UNIFIED_PREVIEW === "1" ? "/explorer/" : "/";
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><meta name="description" content="Free, manually initiated read-only Ethereum and Base inspections in the separate PIT Explorer." /><title>PIT Explorer · Free read-only inspections</title></head><body><a class="skip" href="#main">Skip to main content</a><main id="main" class="shell"><ExplorerNav catalogueHref={catalogueHref} />
<section class="hero"><p class="eyebrow">Free Explorer</p><h1>Inspect the chain.</h1><p>{V2_EXPLORER_TASKS.length} read-only inspections across supported Ethereum and Base networks. Choose what to inspect, then request the data.</p></section>
<section class="catalogue-controls" aria-label="Find an inspection"><label class="field">Search inspections<input id="explorer-search" type="search" autocomplete="off" placeholder="Search title or purpose" /></label><label class="field">Category<select id="explorer-category"><option value="all">All inspection topics</option>{EXPLORER_CATEGORIES.map((category) => <option value={category}>{category} ({EXPLORER_TOOLS.filter((tool) => tool.category === category).length})</option>)}</select></label><label class="field">Network<select id="explorer-network"><option value="all">All supported networks</option><option value="ethereum">Ethereum</option><option value="base">Base</option><option value="base-sepolia">Base Sepolia</option></select></label><p id="explorer-count" role="status" aria-live="polite">{EXPLORER_TOOLS.length} inspections shown</p></section>
<div class="grid" id="explorer-catalogue">{EXPLORER_TOOLS.map((tool) => <a class="card" href={`/inspect/${tool.id}/`} data-category={tool.category} data-networks={tool.chains.join(" ")} data-search={`${tool.title} ${tool.question} ${tool.category} ${tool.id}`.toLowerCase()}><small>{tool.category}</small><h2>{tool.title}</h2><p>{tool.question}</p><span class="card-foot"><span>Free</span><span>Open</span></span></a>)}</div><details class="explorer-about"><summary>Privacy and data limits</summary><p>Public RPC providers receive the values you submit. Results are snapshots at displayed blocks, not complete security assessments. No wallet, signature or transaction is available.</p></details><footer>Private candidate · No indexing · No financial advice</footer></main><script src="../explorer-browser.ts"></script></body></html>
