---
import { EXPLORER_CATEGORIES, EXPLORER_TOOLS } from "../../lib/explorer-registry";
import { V2_EXPLORER_TASKS } from "../../lib/v2-explorer-catalog";
import "../explorer.css";
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><meta name="description" content="Free, manually initiated read-only Ethereum and Base inspections in the separate PIT Explorer." /><title>PIT Explorer · Free read-only inspections</title></head><body><a class="skip" href="#main">Skip to main content</a><main id="main" class="shell"><header><a class="brand" href="/">pit<span>.</span> explorer</a><nav aria-label="Main navigation"><a href="/" aria-current="page">Explorer</a></nav><span class="tag">PRIVATE · READ-ONLY</span></header>
<section class="hero"><small>Blockchain Explorer · PIT V2</small><h1>Read public-chain facts when you choose.</h1><p>{V2_EXPLORER_TASKS.length} free inspections on supported Ethereum and Base networks. Enter an address, token, name or transaction hash, then start a bounded read. No account, wallet connection, signature or transaction is available.</p><p class="muted">The separate offline Toolbox uses manual inputs without network requests. Here, public RPC providers receive only the inputs you explicitly submit. Results are snapshots at displayed blocks, not complete security assessments.</p></section>
<section class="catalogue-controls" aria-label="Find an inspection"><label class="field">Search inspections<input id="explorer-search" type="search" autocomplete="off" placeholder="Search title or purpose" /></label><label class="field">Category<select id="explorer-category"><option value="all">All inspection topics</option>{EXPLORER_CATEGORIES.map((category) => <option value={category}>{category} ({EXPLORER_TOOLS.filter((tool) => tool.category === category).length})</option>)}</select></label><label class="field">Network<select id="explorer-network"><option value="all">All supported networks</option><option value="ethereum">Ethereum</option><option value="base">Base</option><option value="base-sepolia">Base Sepolia</option></select></label><p id="explorer-count" role="status" aria-live="polite">{EXPLORER_TOOLS.length} inspections shown</p></section>
<div class="grid" id="explorer-catalogue">{EXPLORER_TOOLS.map((tool) => <a class="card" href={`/inspect/${tool.id}/`} data-category={tool.category} data-networks={tool.chains.join(" ")} data-search={`${tool.title} ${tool.question} ${tool.category} ${tool.id}`.toLowerCase()}><small>Blockchain Explorer · {tool.category}</small><h2>{tool.title}</h2><p>{tool.question}</p><small>{tool.chains.map((chain) => chain === "ethereum" ? "Ethereum" : chain === "base" ? "Base" : "Base Sepolia").join(" / ")} · Free · Read-only · No wallet</small></a>)}</div><footer>Private candidate · No indexing · No financial advice</footer></main><script src="../explorer-browser.ts"></script></body></html>
