---
import { EXPLORER_TOOLS } from "../../../../lib/explorer-registry";
import "../../../explorer.css";
export function getStaticPaths() { return EXPLORER_TOOLS.map((tool) => ({ params: { id: tool.id }, props: { tool } })); }
const { tool } = Astro.props;
const chainLabel = (chain: string) => chain === "ethereum" ? "Ethereum mainnet" : chain === "base" ? "Base mainnet" : "Base Sepolia";
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><meta name="description" content={tool.question} /><title>{tool.title} · PIT Explorer</title></head><body><a class="skip" href="#main">Skip to main content</a><main id="main" class="shell"><header><a class="brand" href="/">pit<span>.</span> explorer</a><nav aria-label="Main navigation"><a href="/">All inspections</a></nav><span class="tag">FREE · READ-ONLY</span></header><section class="hero"><small>Blockchain Explorer · {tool.category}</small><h1>{tool.title}</h1><p>{tool.question}</p><p class="muted">Available now · Free · No wallet required · {tool.chains.map(chainLabel).join(" / ")}</p><p class="muted">{tool.limitation}</p></section><form id="explorer-form" data-tool={tool.id} class="panel"><label class="field">Network<select name="chain" required>{tool.chains.map((chain) => <option value={chain}>{chainLabel(chain)}</option>)}</select></label>{tool.fields.map((field) => <label class="field">{field.label}{field.kind === "textarea" ? <textarea name={field.id} placeholder={field.example} required={field.required !== false} maxlength={field.maxLength ?? 1024}></textarea> : field.kind === "select" ? <select name={field.id} required={field.required !== false}>{field.options?.map((option) => <option value={option}>{option}</option>)}</select> : <input name={field.id} type="text" placeholder={field.example} required={field.required !== false} maxlength={field.maxLength ?? 1024} autocomplete="off" />}</label>)}{tool.id === "batch-balances" && <label class="field">Import wallet-address CSV locally<input id="batch-address-file" type="file" accept=".csv,text/csv" /></label>}<button type="submit">Query public chain</button><p class="muted">Your supplied inputs are sent only after you select this button. The fixed public RPC endpoint and block are displayed with each result. No PIT service fee is charged.</p></form><section aria-labelledby="result-title"><h2 id="result-title">Read result</h2><output id="explorer-output" role="status" aria-live="polite">No query sent.</output>{tool.id === "batch-balances" && <button type="button" id="batch-export" hidden>Download balance CSV</button>}</section><footer><a href="/">← All inspections</a> · Public state can change · No wallet, signing or execution</footer></main><script src="../../../explorer-browser.ts"></script></body></html>
