---
import { LOCAL_TOOLS } from "../../lib/local-toolbox";
import { V2_LOCAL_TASKS } from "../../lib/v2-local-catalog";
import { PLANNED_OPERATIONS, V2_CATEGORIES } from "../../lib/v2-catalog-core";
import "../../styles/global.css";
import "../local.css";
const featured = ["portfolio-exposure", "swap-cost", "impermanent-loss"].map((id) => LOCAL_TOOLS.find((tool) => tool.id === id)!);
const canonical = Astro.site ? new URL("/", Astro.site).href : undefined;
---
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="PIT offers free browser-local Web3 calculations. Explore trading risk, token data, DeFi and portfolio analysis without an account or wallet." />{canonical && <link rel="canonical" href={canonical} />}<meta property="og:type" content="website" /><meta property="og:site_name" content="PIT" /><meta property="og:title" content="PIT · Web3 tools with clear assumptions" /><meta property="og:description" content="Free browser-local analysis today; separately reviewed Web3 operations may follow." />{canonical && <meta property="og:url" content={canonical} />}<title>PIT · Free Web3 tools</title></head><body><a class="local-skip" href="#main-content">Skip to main content</a><main class="shell" id="main-content">
  <header><a href="./" class="brand">pit<span>.</span></a><nav aria-label="Main navigation"><a href="./tools/">Toolbox</a><a href="./privacy/">Privacy</a><a href="./legal/">Site information</a></nav><span class="tag">{Astro.site ? "FREE LOCAL TOOLS" : "PRIVATE LOCAL CANDIDATE"}</span></header>
  <section class="hero local-intro"><div class="eyebrow">PIT · Web3 utility platform</div><h1>Understand Web3 positions, costs and risks before you act.</h1><p>{V2_LOCAL_TASKS.length} focused experiences use manual inputs in your browser. No account, wallet connection or subscription is needed for these free tools.</p><div class="local-actions"><a class="button-link primary" href="./tools/">Explore free tools</a><a class="button-link" href="./tools/#tool-search">Search the catalogue</a></div><p class="muted">A separate read-only Explorer queries selected public chains only when asked. Future token operations are still proposals: no operational or payment flow is available here.</p></section>
  <section class="home-section" aria-labelledby="start-title"><div class="eyebrow">Start with a question</div><h2 id="start-title">Popular free tools</h2><div class="tool-grid">{featured.map((tool) => <a class="panel tool-card feature-card" href={`./tools/${tool.slug}/`}><span class="eyebrow">Free · browser-local · no wallet</span><h3>{tool.title}</h3><p>{tool.description}</p><span class="feature-link">Open tool →</span></a>)}</div></section>
  <section class="home-section" aria-labelledby="categories-title"><div class="eyebrow">Explore by purpose</div><h2 id="categories-title">Nine paths through Web3</h2><div class="local-task-grid">{V2_CATEGORIES.map((category) => { const count = V2_LOCAL_TASKS.filter((task) => task.category === category.id).length; const plans = PLANNED_OPERATIONS.filter((item) => item.category === category.id).length; const detail = `${count} free local experiences${plans ? ` · ${plans} proposed operation${plans === 1 ? "" : "s"}` : ""}`; return category.id === "blockchain-explorer" ? <div class="panel local-task-card"><h3>{category.label}</h3><p>{category.description}</p><small>Separate read-only product; no Explorer route in this offline build.</small></div> : <a class="panel local-task-card" href={`./tools/#category-${category.id}`}><h3>{category.label}</h3><p>{category.description}</p><small>{detail}</small></a>; })}</div></section>
  <section class="home-section home-split"><div class="panel"><h2>Free analysis now</h2><p>Calculators and inspectors state their inputs, units and limits. Your financial inputs stay in the browser session; hosting still receives normal page requests.</p></div><div class="panel"><h2>Operations later</h2><p>Token creation, distribution and locking would require separate security review, wallet consent, gas estimates and transparent PIT fees. Indicative prices are proposals, not a checkout.</p></div></section>
  <footer><a href="./privacy/">Privacy</a> · <a href="./legal/">Site information</a> · {Astro.site ? "Free local tools · No financial advice" : "Private-QA candidate · No indexing"}</footer>
</main></body></html>
