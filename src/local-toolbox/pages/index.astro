---
import { LOCAL_TASK_GROUPS, LOCAL_TOOLS } from "../../lib/local-toolbox";
import "../../styles/global.css";
import "../local.css";
const featured = ["portfolio-exposure", "swap-cost", "impermanent-loss"].map((id) => LOCAL_TOOLS.find((tool) => tool.id === id)!);
const canonical = Astro.site ? new URL("/", Astro.site).href : undefined;
---
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Twenty browser-local DeFi tools for manually exploring positions, costs and risks. No wallet or live price feed." />{canonical && <link rel="canonical" href={canonical} />}<meta property="og:type" content="website" /><meta property="og:site_name" content="PIT" /><meta property="og:title" content="PIT · Local DeFi Toolbox" /><meta property="og:description" content="Understand DeFi positions, costs and risks with 20 browser-local tools and your own assumptions." />{canonical && <meta property="og:url" content={canonical} />}<title>PIT · Local DeFi Toolbox</title></head><body><a class="local-skip" href="#main-content">Skip to main content</a><main class="shell" id="main-content">
  <header><a href="./" class="brand">pit<span>.</span></a><nav aria-label="Main navigation"><a href="./tools/">Toolbox</a><a href="./privacy/">Privacy</a><a href="./legal/">Site information</a></nav><span class="tag">{Astro.site ? "LOCAL TOOLBOX" : "LOCAL TOOLBOX CANDIDATE"}</span></header>
  <section class="hero local-intro"><div class="eyebrow">PIT · browser-local DeFi tools</div><h1>Understand your DeFi positions, costs and risks with free browser-local tools.</h1><p>Enter your own assumptions to explore portfolio exposure, transaction costs, yield and liquidity. No wallet connection, RPC, live quote or account is needed.</p><div class="local-actions"><a class="button-link primary" href="./tools/">Explore all 20 tools</a><a class="button-link" href="./tools/portfolio-exposure/">Analyze portfolio exposure</a></div><p class="muted">Results are models based on your inputs. PIT does not discover holdings, supply market prices or provide financial advice.</p></section>
  <section class="home-section" aria-labelledby="start-title"><div class="eyebrow">Start here</div><h2 id="start-title">Three useful first steps</h2><div class="tool-grid">{featured.map((tool) => <a class="panel tool-card feature-card" href={`./tools/${tool.slug}/`}><span class="eyebrow">Local · no wallet</span><h3>{tool.title}</h3><p>{tool.description}</p><span class="feature-link">Open tool →</span></a>)}</div></section>
  <section class="home-section" aria-labelledby="tasks-title"><div class="eyebrow">Choose a task</div><h2 id="tasks-title">Find the right calculation.</h2><div class="local-task-grid">{LOCAL_TASK_GROUPS.map((group) => <a class="panel local-task-card" href={`./tools/#${group.id}`}><h3>{group.label}</h3><p>{group.ids.length} local tools · manual inputs · no wallet</p><span class="feature-link">Explore →</span></a>)}</div></section>
  <section class="home-section home-split"><div class="panel"><h2>How it works</h2><p>Choose a tool, load its illustrative example, then replace it with your own assumptions. Read the stated units, rounding and missing-cost limits before using a result.</p></div><div class="panel"><h2>Privacy and limits</h2><p>Calculation inputs stay in this browser session. Hosting still receives normal page and asset requests, including ordinary request metadata. These models are neither live prices nor executable transactions.</p></div></section>
  <footer><a href="./privacy/">Privacy</a> · <a href="./legal/">Site information</a> · {Astro.site ? "Browser-local tools · No financial advice" : "Private-QA candidate · No indexing"}</footer>
</main></body></html>
