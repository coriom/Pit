---
import { LOCAL_TOOLS } from "../../lib/local-toolbox";
import { V2_LOCAL_TASKS } from "../../lib/v2-local-catalog";
import { PLANNED_OPERATIONS, V2_CATEGORIES } from "../../lib/v2-catalog-core";
import "../../styles/global.css";
import "../local.css";
import ToolboxNav from "../components/ToolboxNav.astro";
const featured = ["portfolio-exposure", "swap-cost", "impermanent-loss"].map((id) => LOCAL_TOOLS.find((tool) => tool.id === id)!);
const canonical = Astro.site ? new URL("/", Astro.site).href : undefined;
---
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="PIT offers free browser-local Web3 calculations. Explore trading risk, token data, DeFi and portfolio analysis without an account or wallet." />{canonical && <link rel="canonical" href={canonical} />}<meta property="og:type" content="website" /><meta property="og:site_name" content="PIT" /><meta property="og:title" content="PIT · Web3 tools with clear assumptions" /><meta property="og:description" content="Free browser-local analysis today; separately reviewed Web3 operations may follow." />{canonical && <meta property="og:url" content={canonical} />}<title>PIT · Free Web3 tools</title></head><body><a class="local-skip" href="#main-content">Skip to main content</a><main class="shell" id="main-content">
  <ToolboxNav root="./" current="home" />
  <section class="hero local-intro"><p class="eyebrow">Free Toolbox</p><h1>Make sense of the numbers.</h1><p>Explore {V2_LOCAL_TASKS.length} focused calculations and data tools. No account or wallet needed.</p><div class="local-actions"><a class="button-link primary" href="./tools/">Explore tools</a><a class="button-link" href="./tools/#tool-search">Search tools</a></div></section>
  <section class="home-section" aria-labelledby="start-title"><h2 id="start-title">Start with a tool</h2><div class="tool-grid">{featured.map((tool) => <a class="panel tool-card feature-card" href={`./tools/${tool.slug}/`}><h3>{tool.title}</h3><p>{tool.description}</p><span class="feature-link">Open</span></a>)}</div></section>
  <section class="home-section" aria-labelledby="categories-title"><div class="eyebrow">Explore by purpose</div><h2 id="categories-title">Nine paths through Web3</h2><div class="local-task-grid">{V2_CATEGORIES.map((category) => { const count = V2_LOCAL_TASKS.filter((task) => task.category === category.id).length; const plans = PLANNED_OPERATIONS.filter((item) => item.category === category.id).length; const detail = `${count} free local experiences${plans ? ` · ${plans} proposed operation${plans === 1 ? "" : "s"}` : ""}`; return category.id === "blockchain-explorer" ? <div class="panel local-task-card" data-category={category.id}><span class="category-symbol" aria-hidden="true"></span><h3>{category.label}</h3><p>{category.description}</p><small>Separate read-only product; no Explorer route in this offline build.</small></div> : <a class="panel local-task-card" data-category={category.id} href={`./tools/#category-${category.id}`}><span class="category-symbol" aria-hidden="true"></span><h3>{category.label}</h3><p>{category.description}</p><small>{detail}</small></a>; })}</div></section>
  <details class="local-home-details"><summary>Privacy and availability</summary><p>Calculations run from values you enter in this browser. The separate Explorer makes public RPC requests only when asked. Transaction workflows remain separate local prototypes; no checkout or payment is available in this Toolbox.</p></details>
  <footer><a href="./privacy/">Privacy</a> · <a href="./legal/">Site information</a> · {Astro.site ? "Free local tools · No financial advice" : "Private-QA candidate · No indexing"}</footer>
</main></body></html>
