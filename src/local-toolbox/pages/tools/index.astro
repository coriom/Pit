---
import { V2_LOCAL_TASKS, V2_LOCAL_WORKSPACES } from "../../../lib/v2-local-catalog";
import { PLANNED_OPERATIONS, V2_CATEGORIES, categoryLabel } from "../../../lib/v2-catalog-core";
import "../../../styles/global.css";
import "../../local.css";
import ToolboxNav from "../../components/ToolboxNav.astro";
const canonical = Astro.site ? new URL("/tools/", Astro.site).href : undefined;
---
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Search free PIT Web3 tools by task and category. Planned operations are clearly marked and cannot be executed." />{canonical && <link rel="canonical" href={canonical} />}<meta property="og:type" content="website" /><meta property="og:site_name" content="PIT" /><meta property="og:title" content="Find a Web3 tool · PIT" /><meta property="og:description" content="Free local analysis and clearly separated future Web3 operations." />{canonical && <meta property="og:url" content={canonical} />}<title>Find a Web3 tool · PIT</title></head><body><a class="local-skip" href="#main-content">Skip to main content</a><main class="shell" id="main-content">
  <ToolboxNav root="../" current="tools" />
  <section class="hero local-catalog-hero"><h1>Find a tool.</h1><p>{V2_LOCAL_TASKS.length} free calculations and data tools, organized for quick access.</p></section>
  <section class="panel v2-catalog-controls" aria-label="Find a tool"><label class="local-search" for="tool-search">Search tools by name or purpose<input id="tool-search" type="search" autocomplete="off" placeholder="Try risk, vesting, token or CSV" /></label><div class="v2-selects"><label>Availability<select id="availability-filter"><option value="all">All availability</option><option value="available">Free and available</option><option value="planned">Proposed only</option></select></label></div>
    <div class="local-filter-list" role="group" aria-label="Tool view"><button type="button" data-filter="workspaces" aria-pressed="true">20 workspaces</button><button type="button" data-filter="tasks" aria-pressed="false">Focused tasks</button><button type="button" data-filter="all" aria-pressed="false">All entries</button></div>
    <div class="local-filter-list v2-category-filters" role="group" aria-label="PIT categories"><button type="button" data-category-filter="all" aria-pressed="true">All categories</button>{V2_CATEGORIES.map((category) => <button type="button" data-category-filter={category.id} aria-pressed="false">{category.label} <small>{category.id === "blockchain-explorer" ? "separate" : `${V2_LOCAL_TASKS.filter((task) => task.category === category.id).length} local`}</small></button>)}</div>
    <p id="tool-match-count" class="muted" role="status" aria-live="polite">{V2_LOCAL_WORKSPACES.length} entries shown</p>
  </section>
  <section id="workspaces" class="local-group" data-collection="workspaces" aria-label="Full workspaces"><h2>Full workspaces</h2><div class="tool-grid">{V2_LOCAL_WORKSPACES.map((tool) => <a class="panel tool-card local-card" data-tool={tool.id} data-card data-category={tool.category} data-network="none" data-availability="available" data-search={`${tool.title} ${tool.description} ${categoryLabel(tool.category)} ${tool.tags.join(" ")}`.toLowerCase()} href={tool.path?.replace("/tools/", "") ?? "#"}><span class="local-card-category">{categoryLabel(tool.category)}</span><h3>{tool.title}</h3><p>{tool.description}</p><span class="local-card-foot"><span>Free</span><span>Open</span></span></a>)}</div></section>
  <section id="individual-tasks" class="local-group" data-collection="tasks" aria-label="Focused tasks" hidden><h2>Focused tasks</h2><div class="tool-grid">{V2_LOCAL_TASKS.filter((task) => task.path?.startsWith("/tasks/")).map((task) => <a class="panel tool-card local-card" data-task={task.id} data-card data-category={task.category} data-network="none" data-availability="available" data-search={`${task.title} ${task.description} ${categoryLabel(task.category)} ${task.tags.join(" ")}`.toLowerCase()} href={`..${task.path}`}><span class="local-card-category">{categoryLabel(task.category)}</span><h3>{task.title}</h3><p>{task.description}</p><span class="local-card-foot"><span>Free</span><span>Open</span></span></a>)}</div></section>
  <section id="future-operations" class="local-group" data-collection="planned" aria-label="Proposed operations" hidden><h2>Future operations · proposals only</h2><p class="muted">These are not working tools. Fees are indicative PIT service fees; blockchain gas would be separate. No total cost or payment route exists.</p><div class="tool-grid">{PLANNED_OPERATIONS.map((item) => <article class="panel tool-card local-card v2-planned-card" data-card data-category={item.category} data-network="undecided" data-availability="planned" data-search={`${item.title} ${item.description} ${categoryLabel(item.category)}`.toLowerCase()}><span class="eyebrow">{categoryLabel(item.category)} · Coming later</span><h3>{item.title}</h3><p>{item.description}</p><small>Proposed PIT fee: {item.indicativeFee} · Gas separate · Network undecided</small><p class="muted">No wallet action, checkout or transaction is available.</p></article>)}</div></section>
  <p id="tool-empty" class="panel local-empty" hidden>No matching item in this build. The read-only Explorer is a separate product; proposed operations cannot run here.</p>
  <footer><a href="../">← Home</a> · <a href="../privacy/">Privacy</a> · <a href="../legal/">Site information</a> · Free tools stay free · No financial advice</footer>
</main>
<script>
  const search = document.querySelector<HTMLInputElement>("#tool-search");
  const viewButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const categoryButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-category-filter]")];
  const availability = document.querySelector<HTMLSelectElement>("#availability-filter");
  const collections = [...document.querySelectorAll<HTMLElement>("[data-collection]")];
  const count = document.querySelector<HTMLElement>("#tool-match-count");
  const empty = document.querySelector<HTMLElement>("#tool-empty");
  let view = location.hash === "#individual-tasks" ? "tasks" : "workspaces";
  let category = location.hash.startsWith("#category-") ? location.hash.slice(10) : "all";
  if (category !== "all") view = "all";
  function update() {
    const query = search?.value.trim().toLocaleLowerCase() ?? "";
    let shown = 0;
    for (const collection of collections) {
      let within = 0;
      for (const card of collection.querySelectorAll<HTMLElement>("[data-card]")) {
        const match = (view === "all" || view === collection.dataset.collection) && (category === "all" || card.dataset.category === category) &&
          (availability?.value === "all" || card.dataset.availability === availability?.value) &&
          (card.dataset.search ?? "").includes(query);
        card.hidden = !match;
        if (match) { shown++; within++; }
      }
      collection.hidden = within === 0;
    }
    for (const button of viewButtons) button.setAttribute("aria-pressed", String(button.dataset.filter === view));
    for (const button of categoryButtons) button.setAttribute("aria-pressed", String(button.dataset.categoryFilter === category));
    if (count) count.textContent = `${shown} ${shown === 1 ? "entry" : "entries"} shown`;
    if (empty) empty.hidden = shown !== 0;
  }
  search?.addEventListener("input", () => { if (search.value.trim()) { view = "all"; category = "all"; } update(); });
  for (const button of viewButtons) button.addEventListener("click", () => { view = button.dataset.filter ?? "all"; update(); });
  for (const button of categoryButtons) button.addEventListener("click", () => { category = button.dataset.categoryFilter ?? "all"; view = "all"; update(); });
  availability?.addEventListener("change", () => { view = "all"; update(); });
  addEventListener("hashchange", () => {
    if (!location.hash.startsWith("#category-")) return;
    category = location.hash.slice(10);
    view = "all";
    update();
  });
  update();
</script></body></html>
