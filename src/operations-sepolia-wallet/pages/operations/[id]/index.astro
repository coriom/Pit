---
import Layout from "../../../components/Layout.astro";
import { operationCatalog } from "../../../../operations/lib/catalog";
import { previewDescriptions } from "../../../../operations-sepolia/preview-copy";
export function getStaticPaths(){return operationCatalog.map((item)=>({params:{id:item.id},props:{item}}));}
const { item } = Astro.props;
---
<Layout title={item.title} description={previewDescriptions[item.id]}><section class="hero"><div class="eyebrow">{item.category} · Base Sepolia private wallet test</div><h1>{item.title}</h1><p>{previewDescriptions[item.id]}</p><p class="notice">Indicative PIT service fee: {item.fee}, inactive. Every testnet transaction needs a separately approved campaign and explicit wallet confirmation.</p></section><div id="operation-root" data-operation={item.id}></div><script src="../../../../operations/sepolia-wallet-browser.ts"></script></Layout>
