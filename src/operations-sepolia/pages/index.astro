---
import Layout from "../components/Layout.astro";
import { operationCatalog } from "../../operations/lib/catalog";
import { previewDescriptions } from "../preview-copy";
---
<Layout title="PIT operations" description="Inspect verified Base Sepolia demonstration contracts without signing or broadcasting."><section class="hero"><div class="eyebrow">PIT V2 · Base Sepolia read-only preview</div><h1>Inspect the PIT testnet operations.</h1><p>Read the reviewed demonstration contracts on Base Sepolia. This private preview cannot connect a wallet, sign, or send transactions. Testnet transaction controls await separate browser acceptance.</p><p class="notice">Commercial fees are indicative proposals and inactive.</p></section><div class="grid">{operationCatalog.map((item)=><a class="panel" href={`/operations/${item.id}/`}><small class="eyebrow">{item.category}</small><h2>{item.title}</h2><p>{previewDescriptions[item.id]}</p><small>Indicative PIT fee: {item.fee} · inactive</small></a>)}</div></Layout>
