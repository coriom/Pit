    "@tanstack/react-query": "^5.104.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^5.18.2",
    "connectkit": "^1.9.2",
    "cross-fetch": "^3.2.0",
    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
